FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

ARG LIVEBENCH_COMMIT=5d3c086eb2c0a85fa99a13612375676ce94556db
ARG LIVECODEBENCH_COMMIT=28fef95ea8c9f7a547c8329f2cd3d32b92c1fa24

RUN apt-get update \
    && apt-get install -y --no-install-recommends git gcc g++ \
    && git clone https://github.com/LiveBench/LiveBench.git /opt/livebench \
    && git -C /opt/livebench checkout "$LIVEBENCH_COMMIT" \
    && pip install --no-cache-dir -e /opt/livebench \
    && python -m spacy download en_core_web_sm \
    && python -c "import nltk; nltk.download('punkt', quiet=True); nltk.download('punkt_tab', quiet=True)" \
    && git clone https://github.com/LiveCodeBench/LiveCodeBench.git /opt/livecodebench \
    && git -C /opt/livecodebench checkout "$LIVECODEBENCH_COMMIT" \
    && pip install --no-cache-dir "datasets==3.6.0" "pebble>=5.1" numpy tqdm \
    && apt-get purge -y git gcc g++ \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /root/.cache

RUN pip install --no-cache-dir "lxml==6.1.3"

ENV PYTHONPATH=/opt/livebench:/opt/livecodebench PYTHONUNBUFFERED=1
COPY score_quick.py /opt/scorer/score_quick.py
ENTRYPOINT ["python", "/opt/scorer/score_quick.py"]
