---
import Base from "../layouts/Base.astro";
import community from "../../../community/index.json";
import leaderboard from "../../../leaderboard/index.json";
import result from "../../../results/index.json";

interface LeaderboardRow {
  id: string;
  run_type: "official" | "community" | "partner";
  provider: string;
  model: string;
  benchmark: string;
  reasoning_effort: string;
  dataset_release: string;
  questions: number;
  attempts: number;
  score: { value: number; unit: "percent" | "points" };
  reference: { source: string; value: number; url: string };
  artifact_url: string;
}


const models = ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna", "gpt-5.5"];
const leaderboardRows = leaderboard.rows as LeaderboardRow[];
const benchmarkFilters = ["arc-agi-2", "livebench", "hle", "gpqa-diamond", "mmlu-pro", "livecodebench"];
const effortFilters = ["none", "low", "medium", "high", "xhigh", "max"];
const runTypeLabels = { official: "Официальный", community: "Community", partner: "Партнёрский" };
const formatScore = (value: number) => value.toLocaleString("ru-RU", { maximumFractionDigits: 3 });
const { manifest, summary, usage, transport } = result;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const artifactUrl = (name: string) => base + "/results/" + manifest.run_id + "/" + name;
const totalTokens = usage.input_tokens + usage.output_tokens;
const files = [
  ["Отчёт", "report.html", "Покрытие, ошибки и расход по запросам"],
  ["Исходные ответы", "attempts.jsonl.gz", "Все успешные запросы, ошибки и ретраи"],
  ["Оценки попыток", "scores.jsonl", "Предсказание, эталон и хеш исходного ответа"],
  ["Итоговая оценка", "score-summary.json", "Результаты всех 120 задач"],
  ["Эталоны", "scoring-key.json", "167 ожидаемых выходных сеток"],
  ["Манифест", "manifest.json", "Модель, effort, версия датасета и полнота"],
];
---

<Base title="ARC-AGI-2 · CheapGPT Benchmarks" description={"Полный ARC-AGI-2: " + manifest.model + " " + manifest.reasoning_effort + " через CheapGPT — " + formatScore(summary.score) + "%. Исходные ответы, хеши и воспроизводимый пересчёт."}>
  <header class="shell nav">
    <a class="wordmark" href="#top" aria-label="Главная">CGPT/BENCH</a>
    <nav aria-label="Основная навигация">
      <a href="#contract">Результат</a><a href="#method">Методология</a><a href="#evidence">Артефакты</a><a href="#leaderboard">Лидерборд</a><a href="https://github.com/kitbuilder587/cheapgpt-benchmarks">GitHub ↗</a>
    </nav>
  </header>

  <main id="top">
    <section class="shell hero">
      <p class="eyebrow">Полный ARC-AGI-2 · {manifest.model} · {manifest.reasoning_effort}</p>
      <h1 class="display">{formatScore(summary.score)}%<br /><em>На полном наборе.</em></h1>
      <div class="hero-foot">
        <p>{summary.tasks} задач, {summary.test_pairs} тестовых пар, {summary.scored_attempts} оценённые попытки через CheapGPT. Результат пересчитан по сохранённым ответам. Завершён 5 сентября 2026.</p>
        <a class="button" href={artifactUrl("report.html")}>Открыть отчёт <span>↗</span></a>
      </div>
    </section>

    <section class="ticker" aria-label="Статус результата">
      <div class="shell ticker-grid">
        <span>RUN</span><strong>{manifest.run_id}</strong>
        <span>ПРОВЕРКА</span><strong>ПЕРЕСЧЁТ + SHA-256</strong>
        <span>ПОДПИСЬ</span><strong>НЕ ПОДПИСАН</strong>
        <span>ПОКРЫТИЕ</span><strong>{summary.scored_attempts}/{summary.expected_attempts}</strong>
      </div>
    </section>

    <section class="shell contract" id="contract" aria-labelledby="contract-heading">
      <div class="section-head compact">
        <div><p class="eyebrow">Последний опубликованный прогон</p><h2 class="display" id="contract-heading">Результат<br /><em>по задачам.</em></h2></div>
        <p>Тестовая пара решена, если хотя бы одна из двух попыток точно совпала с эталоном. Балл задачи — доля решённых пар, итог — среднее по всем 120 задачам.</p>
      </div>
      <div class="contract-table" role="table" aria-label="Результат ARC-AGI-2">
        <div class="contract-row contract-head" role="row"><span>МОДЕЛЬ / МАРШРУТ</span><span>EFFORT</span><span>SCORE</span><span>ПОКРЫТИЕ</span></div>
        <div class="contract-row" role="row"><strong>{manifest.model}</strong><span>{manifest.reasoning_effort}</span><b>{formatScore(summary.score)}%</b><small>CHEAPGPT · {summary.tasks} ЗАДАЧ</small></div>
      </div>
      <div class="run-facts">
        <span><b>{summary.solved_tasks}</b> решены полностью</span>
        <span><b>{summary.partial_tasks}</b> решены частично</span>
        <span><b>{summary.tasks - summary.solved_tasks - summary.partial_tasks}</b> не решены</span>
      </div>
      <div class="contract-links">
        <a href={base + "/results/index.json"}>Результат и SHA-256 <span>↗</span></a>
        <a href={artifactUrl("score-summary.json")}>Все 120 оценок <span>↗</span></a>
        <a href="https://github.com/kitbuilder587/cheapgpt-benchmarks/blob/main/docs/latest-run.md">Условия запуска <span>↗</span></a>
      </div>
    </section>

    <section class="shell run-intro" aria-labelledby="run-heading">
      <div><p class="eyebrow">Расход по сохранённому usage</p><h2 class="display" id="run-heading">{formatScore(totalTokens)}<br /><em>токенов.</em></h2></div>
      <div class="run-copy">
        <p class="lead">{manifest.completed_logical_attempt_count} логические попытки. {manifest.attempt_count} транспортных записей. Все попытки завершены и оценены.</p>
        <p>Учтены {manifest.completed_count} успешных ответов, включая один повтор после ошибки формата. Для {manifest.error_count} HTTP-ошибок usage не получен, поэтому сумма не определяет полный биллинг.</p>
        <div class="run-facts">
          <span><b>{formatScore(usage.input_tokens)}</b> вход</span>
          <span><b>{formatScore(usage.output_tokens)}</b> выход</span>
          <span><b>{formatScore(usage.reasoning_tokens)}</b> reasoning, уже в выходе</span>
        </div>
      </div>
    </section>

    <section class="comparison" id="comparison">
      <div class="shell comparison-grid">
        <div class="comparison-title"><p class="eyebrow">Как читать результат</p><h2 class="display">Наблюдаемое<br /><em>качество.</em></h2></div>
        <div class="verdicts">
          <article><span>01 / ПОЛНОТА</span><h3>Все задачи дошли до оценки</h3><p>Публичный архив содержит все {manifest.attempt_count} транспортных записей. HTTP-ошибки восстановлены ретраями; пропущенных логических попыток нет.</p></article>
          <article><span>02 / ТРАНСПОРТ</span><h3>Прогон возобновлён со streaming</h3><p>После 300-секундных HTTP 504 транспорт изменён: {transport.nonstream.completed} успешных ответов получены без streaming, {transport.stream.completed} — со streaming. В streaming-сегменте {transport.stream.error} транспортных ошибок. Промпты и effort сохранены.</p></article>
          <article><span>03 / ГРАНИЦЫ ВЫВОДА</span><h3>Проверка ответов через указанный маршрут</h3><p>Имя модели в ответе контролируется и нормализуется провайдером. Оно не подтверждает идентичность апстрима. Этот результат проверен пересчётом и хешами, но не подписан как official release.</p></article>
        </div>
      </div>
    </section>

    <section class="method" id="method">
      <div class="shell method-grid">
        <div><p class="eyebrow">Повторяемые условия</p><h2 class="display">Датасет.<br /><em>Запрос.<br />Оценка.</em></h2></div>
        <ol>
          <li><span>01</span><div><strong>Зафиксированный набор</strong><p>ARC-AGI-2 public evaluation: 120 задач, 167 тестовых входов. Ревизия f3283f7; SHA-256 архива указан в манифесте.</p></div></li>
          <li><span>02</span><div><strong>Текстовые сетки, medium</strong><p>Все обучающие примеры и один тестовый вход в запросе. Concurrency 4, лимит 100 RPM, клиентский timeout 1800 секунд. Инструменты не передавались.</p></div></li>
          <li><span>03</span><div><strong>Две логические попытки</strong><p>Точное совпадение всей сетки. Нераспознанный формат допускает повторную генерацию — в этом прогоне такой повтор был один. Условия важны для сравнения с другим harness.</p></div></li>
          <li><span>04</span><div><strong>Проверка без API-запросов</strong><p>Команда ниже проверяет SHA-256, полноту попыток и детерминированно пересчитывает результат по опубликованному архиву.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="shell evidence" id="evidence">
      <div class="section-head compact">
        <div><p class="eyebrow">Проверяемые данные</p><h2 class="display">Открыть<br /><em>исходники.</em></h2></div>
        <p>Сайт читает только явно выбранный результат из results/index.json. Авторизация в запросах скрыта; полный журнал этого прогона сохранён.</p>
      </div>
      <pre class="run-command"><code>uv run python scripts/export_result.py --check</code></pre>
      <div class="source-list">
        {files.map(([label, name, description], i) => <a class="source-row" href={artifactUrl(name)}><span>{String(i + 1).padStart(2, "0")}</span><strong>{label}</strong><p>{description}</p><small>{name.endsWith(".gz") ? "GZIP / JSONL" : name.endsWith(".html") ? "HTML" : "JSON"}</small><b>↗</b></a>)}
      </div>
    </section>

    <section class="shell leaderboard" id="leaderboard" aria-labelledby="leaderboard-heading">
      <div class="section-head compact">
        <div><p class="eyebrow">Только совместимые конфигурации</p><h2 class="display" id="leaderboard-heading">Публичный<br /><em>лидерборд.</em></h2></div>
        <p>Каждая строка имеет независимый reference на том же reasoning effort, точный benchmark contract и ссылку на проверяемые артефакты. Искусственный composite score не используется.</p>
      </div>
      <div class="leaderboard-filters" aria-label="Фильтры лидерборда">
        <label>Модель<select data-leaderboard-filter="model"><option value="">Все</option>{models.map((value) => <option value={value}>{value}</option>)}</select></label>
        <label>Бенчмарк<select data-leaderboard-filter="benchmark"><option value="">Все</option>{benchmarkFilters.map((value) => <option value={value}>{value}</option>)}</select></label>
        <label>Провайдер<select data-leaderboard-filter="provider"><option value="">Все</option>{leaderboard.providers.map((value) => <option value={value}>{value}</option>)}</select></label>
        <label>Effort<select data-leaderboard-filter="effort"><option value="">Все</option>{effortFilters.map((value) => <option value={value}>{value}</option>)}</select></label>
        <label>Тип запуска<select data-leaderboard-filter="run-type"><option value="">Все</option>{Object.entries(runTypeLabels).map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
      </div>
      <div class="leaderboard-table" role="table" aria-label="Сопоставимые прогоны моделей">
        <div class="leaderboard-row leaderboard-head" role="row"><span>ПРОВАЙДЕР / ТИП</span><span>МОДЕЛЬ / EFFORT</span><span>БЕНЧМАРК</span><span>НАШ SCORE</span><span>REFERENCE</span><span>Δ</span></div>
        {leaderboardRows.map((row) => {
          const delta = row.score.value - row.reference.value;
          return <div
            class="leaderboard-row"
            role="row"
            data-leaderboard-row
            data-model={row.model}
            data-benchmark={row.benchmark}
            data-provider={row.provider}
            data-effort={row.reasoning_effort}
            data-run-type={row.run_type}
          >
            <span><strong>{row.provider}</strong><small>{runTypeLabels[row.run_type]} · <a href={row.artifact_url}>артефакты ↗</a></small></span>
            <span><strong>{row.model}</strong><small>{row.reasoning_effort}</small></span>
            <span><strong>{row.benchmark}</strong><small>{row.dataset_release} · {row.questions} вопросов · {row.attempts} попыток</small></span>
            <b>{formatScore(row.score.value)}</b>
            <span><a href={row.reference.url}>{formatScore(row.reference.value)} ↗</a><small>{row.reference.source}</small></span>
            <b class:list={{ positive: delta >= 0 }}>{delta >= 0 ? "+" : ""}{formatScore(delta)}</b>
          </div>;
        })}
        <div class="leaderboard-empty" data-leaderboard-empty>
          <span>{leaderboardRows.length === 0 ? "ПОДПИСАННЫХ РЕЗУЛЬТАТОВ ПОКА НЕТ" : "НЕТ СТРОК ПО ЭТИМ ФИЛЬТРАМ"}</span>
          <p>Последний ARC-AGI-2 показан выше как проверенный неподписанный результат. В этот индекс попадают только результаты, прошедшие отдельный процесс публикации.</p>
        </div>
      </div>
    </section>

    <section class="shell community" id="community" aria-labelledby="community-heading">
      <div class="section-head compact">
        <div><p class="eyebrow">Прогоны разработчиков</p><h2 class="display" id="community-heading">Проверить<br /><em>своим ключом.</em></h2></div>
        <p>Одна команда запускает тот же quick-v1 через CheapGPT. Локальные результаты никуда не отправляются; публикация возможна только явным community bundle через pull request.</p>
      </div>
      <pre class="run-command"><code>CHEAPGPT_API_KEY=... uvx cheapgpt-benchmarks run --model gpt-5.6-sol</code></pre>
      {community.submissions.length === 0 ? (
        <div class="community-empty"><span>0 ПУБЛИЧНЫХ COMMUNITY RUNS</span><p>Первый проверенный bundle появится здесь отдельно от официальных результатов.</p><a href="https://github.com/kitbuilder587/cheapgpt-benchmarks/blob/main/docs/community.md">Как опубликовать результат ↗</a></div>
      ) : (
        <div class="source-list">{community.submissions.map((submission: any) => <div class="source-row"><strong>{submission.model}</strong><p>{submission.profile} · {submission.author}</p><small>COMMUNITY</small></div>)}</div>
      )}
    </section>

    <section class="shell matrix">
      <p class="eyebrow">Матрица полного прогона</p>
      <div class="model-list">
        {models.map((model, i) => <div><span>{String(i + 1).padStart(2, "0")}</span><strong>{model}</strong><small>{["ФЛАГМАН", "БАЛАНС", "МИНИ", "ПРЕДЫДУЩИЙ ФЛАГМАН"][i]}</small></div>)}
      </div>
    </section>
  </main>

  <footer class="shell">
    <p>Подтверждение наблюдаемого качества, а не криптографическое доказательство весов модели.</p>
    <div><a href="https://github.com/kitbuilder587/cheapgpt-benchmarks/blob/main/docs/methodology.md">Методология</a><a href="https://github.com/kitbuilder587/cheapgpt-benchmarks/blob/main/docs/security.md">Безопасность</a><span>Apache-2.0</span></div>
  </footer>

  <script>
    const filters = Array.from(document.querySelectorAll<HTMLSelectElement>("[data-leaderboard-filter]"));
    const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-leaderboard-row]"));
    const empty = document.querySelector<HTMLElement>("[data-leaderboard-empty]");

    const applyLeaderboardFilters = () => {
      let visible = 0;
      rows.forEach((row) => {
        const matches = filters.every((filter) => {
          const value = filter.value;
          const key = filter.dataset.leaderboardFilter;
          return !value || (key && row.getAttribute(`data-${key}`) === value);
        });
        row.hidden = !matches;
        visible += Number(matches);
      });
      if (empty) empty.hidden = visible > 0;
    };

    filters.forEach((filter) => filter.addEventListener("change", applyLeaderboardFilters));
    applyLeaderboardFilters();
  </script>
</Base>

<style>
  .nav { height:76px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--line); font-size:.74rem; }
  .wordmark { color:var(--signal); text-decoration:none; font-weight:500; letter-spacing:.12em; }
  nav { display:flex; gap:28px; } nav a { text-decoration:none; }
  .hero { min-height:690px; padding:110px 0 70px; display:flex; flex-direction:column; justify-content:space-between; }
  .hero h1 { margin-top:22px; font-size:clamp(4.4rem, 10vw, 9rem); line-height:.78; }
  .hero h1 em,.contract h2 em,.full-head h2 em,.run-intro h2 em,.comparison-title h2 em,.leaderboard h2 em,.community h2 em { color:var(--signal); font-weight:400; }
  .hero-foot { align-self:flex-end; width:100%; max-width:560px; display:grid; gap:28px; font-size:.9rem; line-height:1.7; }
  .button { display:flex; justify-content:space-between; padding:18px 20px; background:var(--signal); color:var(--ink); text-decoration:none; font-weight:500; }
  .button:hover { background:var(--paper); color:var(--ink); }
  .ticker { border-block:1px solid var(--line); }
  .ticker-grid { min-height:92px; display:grid; grid-template-columns:auto 1fr auto 1fr auto 1fr auto 1fr; align-items:center; gap:16px; font-size:.63rem; letter-spacing:.08em; }
  .ticker-grid span { color:var(--muted); } .ticker-grid strong { color:var(--signal); }
  .contract { padding-block:130px; border-bottom:1px solid var(--line); }
  .contract-table { border-top:1px solid var(--line); }
  .contract-row { min-height:88px; display:grid; grid-template-columns:1.4fr .6fr .8fr .8fr; align-items:center; gap:20px; border-bottom:1px solid var(--line); font-variant-numeric:tabular-nums; }
  .contract-row strong { font:400 clamp(1.35rem,2.5vw,2.2rem) "Literata",serif; }
  .contract-row b { color:var(--paper); font:400 1.45rem "Literata",serif; }
  .contract-row small { justify-self:end; color:var(--signal); font-size:.56rem; letter-spacing:.08em; }
  .contract-head { min-height:44px; color:var(--muted); font-size:.56rem; letter-spacing:.08em; }
  .contract-links { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; margin-top:28px; background:var(--line); }
  .contract-links a { min-height:68px; padding:15px; display:flex; align-items:center; justify-content:space-between; background:var(--ink); font-size:.62rem; text-decoration:none; }
  .contract-links a:hover { background:var(--signal); color:var(--ink); }
  .full-results { padding-block:130px; border-bottom:1px solid var(--line); }
  .full-head { margin-bottom:54px; }
  .full-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); border-top:1px solid var(--line); border-left:1px solid var(--line); }
  .full-card { min-width:0; padding:30px; border-right:1px solid var(--line); border-bottom:1px solid var(--line); background:linear-gradient(150deg,#171913 0%,var(--ink) 52%); }
  .full-card-head { display:flex; align-items:center; justify-content:space-between; color:var(--muted); font-size:.61rem; letter-spacing:.08em; }
  .full-card .status.close { color:var(--signal); border-color:#60772b; }
  .full-card .status.limited { color:#ffc44d; border-color:#635d3b; }
  .full-card h3 { margin:58px 0 8px; font:400 clamp(2rem,4vw,3.6rem)/1 "Literata",serif; }
  .full-scope { margin:0; color:var(--muted); font-size:.67rem; }
  .score-comparison { display:grid; grid-template-columns:1fr .9fr 1fr; align-items:end; gap:16px; margin:44px 0 36px; padding-block:24px; border-block:1px solid var(--line); }
  .score-comparison > div { min-width:0; display:flex; flex-direction:column; gap:9px; }
  .score-comparison > div:last-child { text-align:right; align-items:flex-end; }
  .score-comparison span { color:var(--muted); font-size:.54rem; letter-spacing:.08em; }
  .score-comparison strong { font:400 clamp(2.15rem,4.5vw,4rem)/.9 "Literata",serif; letter-spacing:-.05em; white-space:nowrap; }
  .score-comparison .delta { align-items:center; text-align:center; }
  .score-comparison .delta strong { color:var(--signal); font-size:clamp(1.2rem,2vw,1.8rem); letter-spacing:-.03em; }
  .score-comparison .delta small { max-width:150px; color:var(--muted); font-size:.52rem; line-height:1.45; }
  .full-summary { min-height:92px; color:var(--paper); font:400 1.05rem/1.55 "Literata",serif; }
  .full-details { display:flex; flex-wrap:wrap; gap:8px; margin:26px 0; }
  .full-details span { padding:8px 10px; border:1px solid var(--line); color:var(--muted); font-size:.57rem; }
  .evidence-links { display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--line); }
  .evidence-links a { min-height:72px; padding:14px; display:flex; align-items:center; justify-content:space-between; gap:12px; background:var(--ink); font-size:.61rem; line-height:1.4; text-decoration:none; transition:background .18s ease,color .18s ease; }
  .evidence-links a:hover { background:var(--signal); color:var(--ink); }
  .evidence-links a span { color:var(--signal); }
  .evidence-links a:hover span { color:var(--ink); }
  .full-disclaimer { max-width:900px; margin:28px 0 0 auto; color:var(--muted); font-size:.68rem; line-height:1.7; }
  .full-disclaimer strong { color:var(--paper); font-weight:500; }
  .run-intro { padding-block:120px; display:grid; grid-template-columns:1fr 1fr; gap:8vw; border-bottom:1px solid var(--line); }
  .run-intro h2 { margin-top:22px; font-size:clamp(4rem,8vw,7rem); line-height:.8; }
  .run-copy { align-self:end; color:var(--muted); font-size:.78rem; line-height:1.8; }
  .run-copy .lead { color:var(--paper); font:400 1.5rem/1.45 "Literata",serif; }
