{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitbuilder587.github.io/cheapgpt-benchmarks/schemas/release-index.schema.json",
  "title": "CheapGPT verified release index",
  "type": "object",
  "required": ["schema_version", "latest_verified_run", "runs"],
  "properties": {
    "schema_version": { "const": 1 },
    "latest_verified_run": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "run_type",
          "provider",
          "model",
          "benchmark",
          "reasoning_effort",
          "dataset_release",
          "scoring_contract",
          "questions",
          "attempts",
          "score",
          "reference",
          "artifact_url",
          "published_at"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "run_type": { "const": "official" },
          "provider": { "const": "CheapGPT" },
          "model": { "type": "string", "minLength": 1 },
          "benchmark": { "enum": ["livebench", "hle", "gpqa-diamond", "mmlu-pro", "livecodebench"] },
          "reasoning_effort": { "enum": ["none", "low", "medium", "high", "xhigh", "max"] },
          "dataset_release": { "type": "string", "minLength": 1 },
          "scoring_contract": { "type": "string", "minLength": 1 },
          "questions": { "type": "integer", "minimum": 1 },
          "attempts": { "type": "integer", "minimum": 1 },
          "score": {
            "type": "object",
            "required": ["value", "unit"],
            "properties": {
              "value": { "type": "number" },
              "unit": { "enum": ["percent", "points"] }
            },
            "additionalProperties": false
          },
          "reference": {
            "type": "object",
            "required": ["source", "value", "url", "snapshot_url", "compatible"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "value": { "type": "number" },
              "url": { "type": "string", "format": "uri" },
              "snapshot_url": { "type": "string", "format": "uri" },
              "compatible": { "const": true }
            },
            "additionalProperties": false
          },
          "artifact_url": { "type": "string", "format": "uri" },
          "published_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
