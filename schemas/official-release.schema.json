{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitbuilder587.github.io/cheapgpt-benchmarks/schemas/official-release.schema.json",
  "title": "CheapGPT signed official benchmark release",
  "type": "object",
  "required": ["schema_version", "release_id", "official", "created_at", "runs", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "release_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$" },
    "official": { "const": true },
    "created_at": { "type": "string", "format": "date-time" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "model",
          "profile",
          "track",
          "reasoning_effort",
          "benchmark_contract",
          "dataset_sha256",
          "attempts",
          "artifacts"
        ],
        "properties": {
          "run_id": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "profile": { "type": "string", "minLength": 1 },
          "track": { "enum": ["default", "leaderboard"] },
          "reasoning_effort": { "type": ["string", "null"] },
          "benchmark_contract": { "type": ["string", "null"] },
          "dataset_sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          },
          "attempts": { "type": "string", "pattern": "^[A-Za-z0-9._-]+-attempts\\.jsonl\\.gz$" },
          "artifacts": {
            "type": "object",
            "required": [
              "manifest.json",
              "scoring-key.json",
              "scores.jsonl",
              "score-summary.json",
              "report.html"
            ],
            "properties": {
              "manifest.json": { "type": "string" },
              "scoring-key.json": { "type": "string" },
              "scores.jsonl": { "type": "string" },
              "score-summary.json": { "type": "string" },
              "report.html": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "object",
      "minProperties": 6,
      "propertyNames": { "pattern": "^[A-Za-z0-9._-]+$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  },
  "additionalProperties": false
}
