{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitbuilder587.github.io/cheapgpt-benchmarks/schemas/reference-matrix.schema.json",
  "type": "object",
  "required": ["schema_version", "retrieved_at", "policy", "contracts", "models", "run_gate"],
  "properties": {
    "schema_version": {"const": 1},
    "retrieved_at": {"type": "string", "format": "date"},
    "policy": {"type": "object"},
    "contracts": {"type": "object", "minProperties": 1},
    "models": {
      "type": "object",
      "required": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna", "gpt-5.5"],
      "additionalProperties": {
        "type": "object",
        "required": ["default_effort", "efforts", "primary_url_pattern"],
        "properties": {
          "default_effort": {"enum": ["low", "medium", "high", "xhigh", "max"]},
          "efforts": {
            "type": "object",
            "minProperties": 5,
            "additionalProperties": {
              "type": "object",
              "required": ["gpqa", "hle"],
              "properties": {
                "gpqa": {"type": "number", "minimum": 0, "maximum": 1},
                "hle": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "additionalProperties": false
            }
          },
          "primary_url_pattern": {"type": "string", "format": "uri"},
          "max_primary_url": {"type": ["string", "null"], "format": "uri"}
        },
        "additionalProperties": false
      }
    },
    "run_gate": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "model",
          "effort",
          "benchmark",
          "contract",
          "decision",
          "reference_url",
          "snapshot_url",
          "reason"
        ],
        "properties": {
          "model": {"type": "string"},
          "effort": {"type": "string"},
          "benchmark": {"type": "string"},
          "contract": {"type": ["string", "null"]},
          "decision": {"enum": ["run", "hold", "exclude"]},
          "reference_url": {"type": ["string", "null"], "format": "uri"},
          "snapshot_url": {"type": ["string", "null"], "format": "uri"},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "excluded_candidates": {"type": "array"}
  },
  "additionalProperties": false
}
